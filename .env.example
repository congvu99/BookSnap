# Copy thành .env khi chạy local. Không commit .env.
DATA_DIR=./data
# Bắt buộc để đăng ký tài khoản mới. Để trống = không ai đăng ký được.
INVITE_CODE=doi-ma-nay
# Local qua http://localhost: Chrome/Firefox chấp nhận cookie Secure; Safari thì cần false.
COOKIE_SECURE=true

GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_RPM=10
# Hạn mức/ngày của key (AI Studio → Rate limits) để hiện "còn lại"; 0 = chỉ hiện đã dùng.
GEMINI_OCR_RPD=0
GEMINI_TTS_RPD=0

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
AZURE_TTS_VOICE=vi-VN-HoaiMyNeural
AZURE_TTS_RPM=20
# Gói F0: 500000 ký tự/tháng
AZURE_TTS_MONTHLY_CHARS=0

# Provider mặc định gán cho sách mới: gemini | azure
TTS_DEFAULT_PROVIDER=gemini

OCR_CONCURRENCY=2
TTS_CONCURRENCY=2
